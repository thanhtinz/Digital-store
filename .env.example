# ── Database (PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digital_store"

# ── App ───────────────────────────────────────────────────────────────
# Public base URL of the site (used in emails, OAuth and payment redirects)
APP_URL="http://localhost:3000"
# Secret for signing session tokens (use a long random string in production)
AUTH_SECRET="change-me-to-a-long-random-string"

# ── Initial admin account (created by `npm run db:seed`) ──────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin12345!"

# ── Everything below is OPTIONAL at boot time ─────────────────────────
# Stripe, PayPal, Google OAuth and SMTP can all be configured from the
# admin panel (Admin → Settings). Environment variables, when present,
# take precedence over values stored in the database.

# Stripe (card payments: Visa, Mastercard, Amex, ...)
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_PUBLISHABLE_KEY="pk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# PayPal (REST, Orders v2)
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# PAYPAL_MODE="sandbox"   # sandbox | live

# Google OAuth login
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# SMTP for transactional email (verification, password reset, receipts)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Digital Store <no-reply@example.com>"
