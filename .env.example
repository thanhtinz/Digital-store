# ===== Cơ bản =====
NODE_ENV=production
PORT=3000

# Domain thật của bạn (có https). Dùng cho link trong mail, OAuth redirect, webhook...
APP_BASE_URL=https://shopcuaban.com

# IP công khai của VPS — dùng để sinh hướng dẫn DNS cho mail (SPF/PTR)
SERVER_IP=123.45.67.89

# ===== Database (PostgreSQL) =====
# Khớp user/password/database đã tạo ở bước 3.4 trong DEPLOY.md
DATABASE_URL=postgresql://sweetuser:doi_mat_khau_nay@localhost:5432/sweetstore

# ===== Bảo mật =====
# Sinh chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=thay_bang_chuoi_ngau_nhien_dai
ADMIN_SECRET=thay_bang_chuoi_bi_mat

# ===== Tài khoản admin seed (chỉ dùng khi chạy deploy.sh --seed) =====
SEED_ADMIN_EMAIL=admin@sweetstore.vn
SEED_ADMIN_PASSWORD=Admin@123456

# ===== Mail =====
# Phần lớn cấu hình mail làm trong Admin (Kết nối & Thông báo → Mail).
# Các biến dưới chỉ là giá trị mặc định/dự phòng nếu chưa cấu hình trong Admin.
MAIL_FROM_EMAIL=no-reply@shopcuaban.com
# Dùng cho chế độ relay nếu không đặt trong Admin:
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ===== SePay (thanh toán) — nên cấu hình trong Admin =====
SEPAY_API_KEY=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=
SEPAY_WEBHOOK_SECRET=

# ===== Google OAuth (tùy chọn) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://shopcuaban.com/api/oauth/google/callback
