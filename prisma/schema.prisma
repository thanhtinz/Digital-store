// Digital Store — Prisma schema
// PostgreSQL. Prices are stored as Decimal(10,2) in the store currency (USD by default).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Users & Auth ───────────────────────────

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique @db.VarChar(255)
  name             String    @db.VarChar(120)
  passwordHash     String?   @map("password_hash")
  role             Role      @default(CUSTOMER)
  avatarUrl        String?   @map("avatar_url")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  googleId         String?   @unique @map("google_id") @db.VarChar(64)
  twoFactorSecret  String?   @map("two_factor_secret") @db.VarChar(64)
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  isBlocked        Boolean   @default(false) @map("is_blocked")
  // Incremented on password change/reset and 2FA changes — instantly
  // invalidates every existing session token for the account.
  sessionVersion   Int       @default(0) @map("session_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  tokens       AuthToken[]
  logins       LoginHistory[]
  cartItems    CartItem[]
  orders       Order[]
  reviews      Review[]
  couponUses   CouponRedemption[]
  wishlist     WishlistItem[]
  tickets      SupportTicket[]

  @@map("users")
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model AuthToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      TokenType
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model LoginHistory {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(400)
  method    String   @default("password") @db.VarChar(20) // password | google | 2fa
  success   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("login_history")
}

// ─────────────────────────── Catalog ───────────────────────────

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(140)
  description String?
  imageUrl    String?  @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Product {
  id           Int      @id @default(autoincrement())
  categoryId   Int?     @map("category_id")
  name         String   @db.VarChar(200)
  slug         String   @unique @db.VarChar(220)
  shortDesc    String?  @map("short_desc") @db.VarChar(500)
  description  String?  // rich HTML — "About this product"
  guide        String?  // rich HTML — "How to use / activation guide"
  isActive     Boolean  @default(true) @map("is_active")
  isFeatured   Boolean  @default(false) @map("is_featured")
  soldCount    Int      @default(0) @map("sold_count")
  ratingAvg    Float    @default(0) @map("rating_avg")
  ratingCount  Int      @default(0) @map("rating_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  category Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images   ProductImage[]
  packages Package[]
  reviews  Review[]
  wishlist WishlistItem[]

  @@index([categoryId, isActive])
  @@map("products")
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  productId Int    @map("product_id")
  url       String
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// A purchasable variant/tier of a product ("1 month", "Family plan", ...).
// `customFields` defines inputs the customer must fill when buying
// (e.g. account email to upgrade, game ID, region) as a JSON array of
// { key, label, type: "text"|"email"|"number", required, placeholder, help }.
model Package {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  name         String   @db.VarChar(160)
  description  String?  @db.VarChar(500)
  price        Decimal  @db.Decimal(10, 2)
  comparePrice Decimal? @map("compare_price") @db.Decimal(10, 2) // strike-through price
  customFields Json?    @map("custom_fields")
  autoDeliver  Boolean  @default(false) @map("auto_deliver") // deliver from StockItem pool on payment
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockItems     StockItem[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  flashSaleItems FlashSaleItem[]

  @@index([productId, isActive])
  @@map("packages")
}

// Pre-loaded digital goods (license keys, account credentials) for auto delivery.
model StockItem {
  id          Int       @id @default(autoincrement())
  packageId   Int       @map("package_id")
  content     String    // the secret delivered to the buyer
  isSold      Boolean   @default(false) @map("is_sold")
  orderItemId Int?      @map("order_item_id")
  soldAt      DateTime? @map("sold_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, isSold])
  @@map("stock_items")
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String?  @db.VarChar(160)
  subtitle  String?  @db.VarChar(300)
  imageUrl  String   @map("image_url")
  linkUrl   String?  @map("link_url")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("banners")
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ─────────────────────────── Promotions ───────────────────────────

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id           Int        @id @default(autoincrement())
  code         String     @unique @db.VarChar(60)
  type         CouponType @default(PERCENT)
  value        Decimal    @db.Decimal(10, 2) // percent (0-100) or fixed amount
  minOrder     Decimal?   @map("min_order") @db.Decimal(10, 2)
  maxDiscount  Decimal?   @map("max_discount") @db.Decimal(10, 2) // cap for PERCENT type
  maxUses      Int?       @map("max_uses")
  usedCount    Int        @default(0) @map("used_count")
  perUserLimit Int?       @map("per_user_limit")
  startsAt     DateTime?  @map("starts_at")
  endsAt       DateTime?  @map("ends_at")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")

  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id        Int      @id @default(autoincrement())
  couponId  Int      @map("coupon_id")
  userId    Int      @map("user_id")
  orderId   Int      @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

model FlashSale {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(160)
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  items FlashSaleItem[]

  @@map("flash_sales")
}

model FlashSaleItem {
  id            Int     @id @default(autoincrement())
  flashSaleId   Int     @map("flash_sale_id")
  packageId     Int     @map("package_id")
  salePrice     Decimal @map("sale_price") @db.Decimal(10, 2)
  quantityLimit Int?    @map("quantity_limit") // max units at sale price (null = unlimited)
  soldCount     Int     @default(0) @map("sold_count")

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  package   Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, packageId])
  @@map("flash_sale_items")
}

// ─────────────────────────── Cart & Orders ───────────────────────────

model CartItem {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  packageId        Int      @map("package_id")
  quantity         Int      @default(1)
  customFieldsData Json?    @map("custom_fields_data")
  createdAt        DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([userId, packageId])
  @@map("cart_items")
}

enum OrderStatus {
  PENDING    // created, awaiting payment
  PAID       // payment confirmed, delivery in progress
  COMPLETED  // all items delivered
  CANCELLED
  REFUNDED
}

model Order {
  id            Int         @id @default(autoincrement())
  code          String      @unique @db.VarChar(20)
  userId        Int         @map("user_id")
  email         String      @db.VarChar(255)
  subtotal      Decimal     @db.Decimal(10, 2)
  discount      Decimal     @default(0) @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)
  currency      String      @default("USD") @db.VarChar(3)
  couponCode    String?     @map("coupon_code") @db.VarChar(60)
  status        OrderStatus @default(PENDING)
  paymentMethod String?     @map("payment_method") @db.VarChar(20) // stripe | paypal
  paymentRef    String?     @map("payment_ref") @db.VarChar(255)   // gateway session/order id
  paidAt        DateTime?   @map("paid_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at")

  user        User               @relation(fields: [userId], references: [id])
  items       OrderItem[]
  couponUses  CouponRedemption[]

  @@index([userId, createdAt])
  @@index([paymentRef])
  @@map("orders")
}

model OrderItem {
  id               Int       @id @default(autoincrement())
  orderId          Int       @map("order_id")
  packageId        Int?      @map("package_id")
  productName      String    @map("product_name") @db.VarChar(200)  // snapshot
  packageName      String    @map("package_name") @db.VarChar(160)  // snapshot
  imageUrl         String?   @map("image_url")                       // snapshot
  quantity         Int       @default(1)
  unitPrice        Decimal   @map("unit_price") @db.Decimal(10, 2)
  lineTotal        Decimal   @map("line_total") @db.Decimal(10, 2)
  customFieldsData Json?     @map("custom_fields_data")
  deliveryData     String?   @map("delivery_data") // keys/credentials/notes delivered to buyer
  deliveredAt      DateTime? @map("delivered_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  package Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ─────────────────────────── Reviews ───────────────────────────

model Review {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  userId     Int      @map("user_id")
  rating     Int      // 1..5
  content    String?
  adminReply String?  @map("admin_reply")
  isApproved Boolean  @default(true) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, isApproved])
  @@map("reviews")
}

// ─────────────────────────── Support ───────────────────────────

enum TicketStatus {
  OPEN      // waiting for staff
  ANSWERED  // staff replied, waiting for customer
  CLOSED
}

model SupportTicket {
  id        Int          @id @default(autoincrement())
  userId    Int          @map("user_id")
  subject   String       @db.VarChar(200)
  orderCode String?      @map("order_code") @db.VarChar(20)
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([userId, updatedAt])
  @@index([status])
  @@map("support_tickets")
}

model TicketMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  isStaff   Boolean  @default(false) @map("is_staff")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_messages")
}

// ─────────────────────────── Media & Settings ───────────────────────────

model MediaFile {
  id        Int      @id @default(autoincrement())
  fileName  String   @map("file_name") @db.VarChar(255)
  mimeType  String   @map("mime_type") @db.VarChar(100)
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("media_files")
}

// Key/value store for site + integration settings, editable in the admin panel.
// Secrets (API keys) live here too; env vars override at read time.
model Setting {
  key       String   @id @db.VarChar(80)
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}
